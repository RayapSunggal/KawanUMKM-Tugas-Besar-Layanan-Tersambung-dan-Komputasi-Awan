# Google Cloud Project
GCP_PROJECT_ID=kawan-umkm

# Firestore
FIRESTORE_COLLECTION=kawan-jobs

# Cloud Storage
GCS_BUCKET_NAME=kawan-uploads-<project-id>

# Pub/Sub
PUBSUB_TOPIC=kawan-jobs
PUBSUB_SUBSCRIPTION=kawan-jobs-sub

# AI Models (diisi AI Engineer — Fase 2)
GEMINI_MODEL_ID=gemini-1.5-flash
VERTEX_IMAGE_MODEL_ID=imagegeneration@006

# Anti-abuse / billing guard
DAILY_GENERATE_CAP=100
RATE_LIMIT_GENERATE_PER_HOUR=5
RATE_LIMIT_UPLOAD_PER_HOUR=10
ALLOWED_ORIGIN=*
TASKS_CALLER_EMAIL=kawan-backend-sa@<project-id>.iam.gserviceaccount.com
WORKER_URL=https://<cloud-run-service-url>
# Hanya untuk dev lokal — JANGAN set true di produksi
ALLOW_INSECURE_WORKER=false
